{
  "name": "lemonotes",
  "version": "1.0.0",
  "description": "LemoNotes: actas y notas por voz, con zumo local de limón.",
  "main": "./out/main/index.js",
  "author": "LemoNotes",
  "license": "MIT",
  "private": true,
  "scripts": {
    "dev": "electron-vite dev",
    "start": "electron-vite preview",
    "typecheck": "tsc --noEmit -p tsconfig.node.json && tsc --noEmit -p tsconfig.web.json",
    "build": "pnpm typecheck && electron-vite build",
    "pack": "pnpm build && electron-builder --dir",
    "build:win": "node scripts/build-win.mjs",
    "build:installer": "pnpm build && electron-builder --win nsis",
    "test": "vitest run",
    "setup:whisper": "node scripts/setup-whisper.mjs"
  },
  "dependencies": {
    "@fontsource-variable/baloo-2": "^5.3.0",
    "@fontsource-variable/lora": "^5.3.0",
    "adm-zip": "^0.6.1",
    "dotenv": "^18.0.10",
    "lucide-react": "^1.77.0",
    "react": "^19.3.1",
    "react-dom": "^19.3.1"
  },
  "devDependencies": {
    "@types/adm-zip": "^0.6.0",
    "@types/node": "^24.10.0",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^5.2.0",
    "electron": "45.4.1",
    "electron-builder": "^26.18.0",
    "electron-vite": "^6.0.0",
    "playwright": "^1.65.1",
    "png-to-ico": "^3.0.2",
    "sharp": "^0.35.5",
    "typescript": "^5.9.3",
    "vite": "^7.3.1",
    "vitest": "^5.1.1"
  }
}
