# Pega aquí tu clave de la API de DeepSeek.
# El modelo flash se usa por defecto. La clave nunca sale del proceso principal.
DEEPSEEK_API_KEY=
DEEPSEEK_MODEL=deepseek-flash
DEEPSEEK_BASE_URL=https://api.deepseek.com

# Opcional: ruta a un whisper-cli.exe propio o a un modelo ggml.
# WHISPER_BIN=
# WHISPER_MODEL=
